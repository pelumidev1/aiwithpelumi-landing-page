{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "apply.aiwithpelumi.com"
        }
      ],
      "destination": "/apply.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "coach.aiwithpelumi.com"
        }
      ],
      "destination": "/coach.html"
    }
  ]
}
