{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "apply.aiwithpelumi.com" }],
      "dest": "/apply.html"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "coach.aiwithpelumi.com" }],
      "dest": "/coach.html"
    },
    { "src": "/posts/?", "dest": "/posts/index.html" },
    { "src": "/posts/([^/]+)/?", "dest": "/posts/$1/index.html" },
    { "src": "/claude-101/?", "dest": "/claude-101/index.html" },
    {
      "src": "/stack/?",
      "status": 307,
      "headers": { "Location": "https://sponge-script-fe4.notion.site/What-I-actually-build-with-3c84384dc0e08048928dc0a7084e0f2b" }
    },
    {
      "src": "/masterclass/?",
      "status": 307,
      "headers": { "Location": "https://selar.com/buidwithaimasterclass" }
    }
  ]
}
